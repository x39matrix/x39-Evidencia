{
	# Log por defecto (journal): fuera los loggers que incluyen IP del cliente
	# (errores de handshake TLS y errores de petición con remote_ip).
	log default {
		exclude http.stdlib http.log.error
	}
}

api.x39matrix.org {
	handle_path /registro/* {
		root * /var/www/x39-registro
		header Access-Control-Allow-Origin "*"
		header Cache-Control "no-cache"
		file_server
	}
	# No habilitar logs de acceso: contienen IP y metadatos de cada petición.
	encode zstd gzip

	request_body {
		max_size 20MB
	}

	@docs path /docs /docs/* /redoc /redoc/* /openapi.json /api/docs /api/docs/* /api/redoc /api/openapi.json
	respond @docs 404

	@admin {
		path /api/notaria/admin/*
		not remote_ip 127.0.0.1 ::1
	}
	respond @admin 404

	reverse_proxy 127.0.0.1:8000 {
		# Necesario solo para aplicar el límite de peticiones por IP en memoria.
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
